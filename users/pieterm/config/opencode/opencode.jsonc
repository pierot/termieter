{
  "$schema": "https://opencode.ai/config.json",
  "model": "omlx/Qwen3.8-27B-oQ4e-mtp",
  "autoupdate": true,
  "formatter": true,
  "lsp": true,
  // Elixir LSP: not installed yet. After `brew install elixir-ls`, replace
  // "lsp": true with an object that adds:
  //   "lsp": {
  //     "typescript": true,
  //     "elixir": { "command": ["elixir-ls"] }
  //   }
  // OpenCode compacts when the context passes limit.context - buffer:
  // 95072 - 31072 = 64000 tokens.
  "compaction": { "auto": true, "keep": { "tokens": 15000 }, "buffer": 31072 },
  "providers": {
    "omlx": {
      "name": "oMLX",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:9000/v1",
        // Inference-only oMLX sub key. The file is outside the dotfiles repo.
        "apiKey": "{file:~/.omlx/opencode.key}"
      },
      "models": {
        "Qwen3.8-27B-oQ4e-mtp": {
          "name": "Qwen3.8-27B-oQ4e-mtp",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          // Equal to max_context_window of this model in oMLX.
          "limit": { "context": 95072, "output": 32000 },
          "body": { "temperature": 1.0, "top_p": 0.95, "top_k": 20 },
          // The chat template rejects reasoning_effort "none".
          "variants": [{ "id": "nothink", "body": { "enable_thinking": false } }]
        }
      }
    }
  },
  // Titles do not need reasoning.
  "agents": { "title": { "model": "omlx/Qwen3.8-27B-oQ4e-mtp#nothink" } },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "*git commit*": "ask",
      "*git push*": "ask",
      "*rm -rf*": "deny"
    },
    // ctx is for Claude Code only. OpenCode also finds ~/.claude/skills/ctx.
    "skill": { "ctx": "deny" }
  }
}
