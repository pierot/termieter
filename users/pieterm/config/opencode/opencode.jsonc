{
  "$schema": "https://opencode.ai/config.json",
  "model": "lmstudio/qwen3.8-27b-ud-single",
  "autoupdate": true,
  "formatter": true,
  "lsp": true,
  // Elixir LSP: not installed yet. After `brew install elixir-ls`, replace
  // "lsp": true with an object that adds:
  //   "lsp": {
  //     "typescript": true,
  //     "elixir": { "command": ["elixir-ls"] }
  //   }
  // OpenCode compacts when the context passes limit.context - buffer:
  // 131072 - 31072 = 100000 tokens.
  "compaction": { "auto": true, "keep": { "tokens": 15000 }, "buffer": 31072 },
  "providers": {
    "lmstudio": {
      "settings": { "baseURL": "http://127.0.0.1:1234/v1" },
      "models": {
        "qwen3.8-27b-ud-single": {
          "name": "qwen3.8-27b-ud-single",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          // LM Studio loads this model with a 131072-token context (`lms ps`).
          "limit": { "context": 131072, "output": 32000 },
          // The LM Studio Inference tab values, sent in every request.
          "body": { "temperature": 1.0, "top_p": 0.95, "top_k": 20, "min_p": 0, "repeat_penalty": 1.0 },
          // LM Studio ignores reasoning_effort, except "none" (thinking off).
          // Without "none", the chat template uses xhigh.
          "variants": [{ "id": "nothink", "settings": { "reasoningEffort": "none" } }]
        }
      }
    }
  },
  // Titles do not need reasoning.
  "agents": { "title": { "model": "lmstudio/qwen3.8-27b-ud-single#nothink" } },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "*git commit*": "ask",
      "*git push*": "ask",
      "*rm -rf*": "deny"
    },
    // ctx is for Claude Code only. OpenCode also finds ~/.claude/skills/ctx.
    "skill": { "ctx": "deny" }
  }
}
