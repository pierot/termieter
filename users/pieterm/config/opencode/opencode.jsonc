{
  "$schema": "https://opencode.ai/config.json",
  "model": "lmstudio/qwen3.8-27b-ud-single",
  "small_model": "lmstudio/qwen3.8-27b-ud-single",
  "autoupdate": true,
  "formatter": true,
  "lsp": true,
  // Elixir LSP: not installed yet. After `brew install elixir-ls`, replace
  // "lsp": true with an object that adds:
  //   "lsp": {
  //     "typescript": true,
  //     "elixir": { "command": ["elixir-ls"] }
  //   }
  "compaction": { "auto": true, "keep": { "tokens": 15000 } },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "lmstudio",
      "options": { "baseURL": "http://127.0.0.1:1234/v1" },
      "models": {
        "qwen3.8-27b-ud-single": {
          "name": "qwen3.8-27b-ud-single",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "attachment": true,
          // LM Studio loads this model with a 124928-token context (`lms ps`).
          "limit": { "context": 124928, "output": 32000 }
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "*git commit*": "ask",
      "*git push*": "ask",
      "*rm -rf*": "deny"
    },
    // ctx is for Claude Code only. OpenCode also finds ~/.claude/skills/ctx.
    "skill": { "ctx": "deny" }
  }
}
