  "model": "opus",
  "hooks": {
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "\"$HOME/.claude/hooks/context-mode-cache-heal.mjs\""
        }
      ]
    }
  ]
},
  "statusLine": {
    "type": "command",
    "command": "/Users/pieterm/.config/claude/statusline.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "context-mode@context-mode": true,
    "claude-hud@claude-hud": true,
    "plannotator@plannotator": true,
    "unraid-mcp@claude-homelab": true,
    "code-simplifier@claude-plugins-official": true,
    "unifi-network@unifi-plugins": true,
    "data@synced": false,
    "finance@synced": false,
    "legal@synced": false,
    "operations@synced": false,
    "product-management@synced": false,
    "productivity@synced": false,
    "sales@synced": false,
    "cowork-plugin-management@synced": false,
    "worktrunk@worktrunk": true
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
