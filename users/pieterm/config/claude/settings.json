      "source": {
        "source": "github",
        "repo": "jmagar/claude-homelab"
      }
    },
    "unifi-plugins": {
      "source": {
        "source": "github",
        "repo": "sirkirby/unifi-mcp"
      }
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-2": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "preferredNotifChannel": "terminal_bell",
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(make deploy) — deploys to production host erin",
      "Bash(make docker_setup_prod) — moves prod-latest tag to production registry"
    ],
    "environment": [
      "### Org-wide",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private (gh check not queryable — origin is gitlab.com, not github.com; inferred from remote and repo naming, not confirmed)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Default / protected branches**: unknown — origin/HEAD unset, branch-protection API not queryable on this host; treat `main` as the deploy branch per CLAUDE.md (every commit on `main` goes to production)",
      "**CI/CD deploy targets**: GitLab CI builds and pushes Docker images (`make docker_build_prod`, `make docker_setup_prod`)",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: Vault at boot-configured `VLT_ADDR`; Sentry (DSN-gated, quiet in dev/test)",
      "**Data retention / declassification**: None configured",
      "**Protected deployment namespaces / environments**: production on `erin` — the sole deploy environment (no staging exists)",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything tagged `prod`/`production`; Ansible-managed cron on `erin` (docker prune) — changes by hand are reverted",
      "### User-specific",
      "**Primary use of Claude Code**: software development (Elixir/Phoenix)",
      "**Org-specific CLIs**: `mix` (Elixir/Phoenix build tool, used routinely in this repo); `wt`/`wt_tmux` (worktrunk, git worktree helper, used routinely)",
      "**routine under this repo prefix**: `mix setup`, `mix phx.server`, `mix test`, `mix precommit` are routine dev commands in this repo"
    ]
  }
}
