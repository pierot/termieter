#!/bin/bash
# tt - project sessions on dwm tags.
#
# A session is a project (or wt worktree) whose windows live on one dwm tag
# (1-6). Switching is a tag switch (super+N, super+Tab for previous); tt
# never kills windows except on -d. Each session starts with three alacritty
# windows: nvim, shell, server (make run). dwm's config.h maps the WM_CLASS
# instance tt<N> to tag N and jumps there on spawn.
#
# Usage:
#   tt <name> [dir]   switch to session <name>; create it if needed
#                     (dir auto-resolved: wt worktree, ~/Work/jackjoe, ~/Work)
#   tt -m             pick a session / project / worktree via dmenu
#   tt -w <branch>    wt switch [--create] <branch>, then open its session
#   tt -n [role]      extra shell window in the current session
#   tt -d [name]      close a session's windows and free its tag
#                     (default: the session of the focused window)
#   tt -l             list sessions
#   tt restore        respawn every saved session without windows (after boot)
#
# State: ~/.cache/tt/sessions, one "tag<TAB>name<TAB>dir<TAB>port" per line.
# Windows carry the instance tt<tag>; that is the only link between the
# state file and X.

STATE="$HOME/.cache/tt/sessions"
MAXTAG=6
MAIN_REPO="$HOME/Work/jackjoe/justified"
mkdir -p "${STATE%/*}"
touch "$STATE"

die() { echo "tt: $*" >&2; exit 1; }

# wt (worktrunk) creates worktrees at ~/Work/jackjoe/.worktrees/<repo>/<branch|sanitize>
resolve_dir() {
  local d
  for d in \
    "$HOME/Work/jackjoe/.worktrees/"*/"$1" \
    "$HOME/Work/jackjoe/$1" \
    "$HOME/Work/$1"; do
    [ -d "$d" ] && { echo "$d"; return 0; }
  done
  return 1
}

# ---- state ---------------------------------------------------------------

entry_by_name() { awk -F'\t' -v n="$1" '$2 == n' "$STATE"; }
entry_by_tag()  { awk -F'\t' -v t="$1" '$1 == t' "$STATE"; }
remove_entry()  { # remove_entry <name>
  awk -F'\t' -v n="$1" '$2 != n' "$STATE" > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"
}
free_tag() {
  local t
  for t in $(seq 1 $MAXTAG); do
    [ -z "$(entry_by_tag "$t")" ] && { echo "$t"; return 0; }
  done
  return 1
}

# ---- X -------------------------------------------------------------------

windows_of() { xdotool search --classname "^tt$1\$" 2>/dev/null; }
is_hot()     { [ -n "$(windows_of "$1")" ]; }
goto_tag()   { xdotool key "super+$1"; }

# windowkill (XKillClient), not windowclose: alacritty survives a destroyed
# window and lingers as a zombie (WM_DELETE is a no-op under dwm)
close_windows() { windows_of "$1" | xargs -r -n1 xdotool windowkill; }

# tag of the focused window, if it is a tt window
current_tag() {
  local i
  i=$(xdotool getactivewindow getwindowclassname 2>/dev/null)
  case "$i" in tt[1-9]) echo "${i#tt}" ;; *) return 1 ;; esac
}

# ---- spawn ---------------------------------------------------------------

# spawn <tag> <dir> <title> [command]
# The command runs in an interactive zsh so it gets the full shell env; when
# it exits (or ctrl-c) the window drops to a prompt instead of closing.
# setsid -f: survive tt's parent being torn down right after tt exits.
spawn() {
  local tag="$1" dir="$2" title="$3" cmd="$4"
  if [ -n "$cmd" ]; then
    setsid -f alacritty --class "Alacritty,tt$tag" --working-directory "$dir" \
      -T "$title" -e zsh -ic "$cmd; exec zsh -i" >/dev/null 2>&1
  else
    setsid -f alacritty --class "Alacritty,tt$tag" --working-directory "$dir" \
      -T "$title" >/dev/null 2>&1
  fi
}

# worktrees get their own PORT so the server can run next to the main one
# (dev.exs reads $PORT, default 5050)
port_for() { # port_for <name> <dir>
  case "$2" in
    */.worktrees/*) echo $((5100 + $(printf %s "$1" | cksum | cut -d' ' -f1) % 400)) ;;
    *) echo "" ;;
  esac
}

# spawn the default three windows. Order matters for the tile layout: nvim
# first so it ends up in the master area.
spawn_session() { # spawn_session <tag> <name> <dir> <port>
  local tag="$1" name="$2" dir="$3" port="$4" server_cmd="make run"
  [ -n "$port" ] && server_cmd="PORT=$port make run"
  spawn "$tag" "$dir" "$name.nvim" nvim
  sleep 0.3
  spawn "$tag" "$dir" "$name.shell"
  sleep 0.3
  spawn "$tag" "$dir" "$name.server" "$server_cmd"
}

open_session() { # open_session <name> [dir]
  local name="$1" dir="$2" entry tag port
  entry=$(entry_by_name "$name")
  if [ -n "$entry" ]; then
    IFS=$'\t' read -r tag name dir port <<<"$entry"
    is_hot "$tag" && { goto_tag "$tag"; return 0; }
    spawn_session "$tag" "$name" "$dir" "$port"
    return 0
  fi
  dir="${dir:-$(resolve_dir "$name")}"
  [ -d "$dir" ] || die "cannot resolve dir for '$name'"
  tag=$(free_tag) || die "all $MAXTAG tags taken; free one with: tt -d <name>"
  port=$(port_for "$name" "$dir")
  printf '%s\t%s\t%s\t%s\n' "$tag" "$name" "$dir" "$port" >> "$STATE"
  spawn_session "$tag" "$name" "$dir" "$port"
}

# ---- picker --------------------------------------------------------------

# sessions first ("[3] name", "[ ] name" when cold), then projects and
# worktrees not yet open
candidates() {
  local -A open
  local tag name dir port
  while IFS=$'\t' read -r tag name dir port; do
    open[$name]=1
    if is_hot "$tag"; then echo "[$tag] $name"; else echo "[ ] $name"; fi
  done < "$STATE"
  {
    find "$HOME/Work/jackjoe/.worktrees" -mindepth 2 -maxdepth 2 -type d -printf '%f\n' 2>/dev/null
    find "$HOME/Work/jackjoe" -mindepth 1 -maxdepth 1 -type d -not -name '.*' -printf '%f\n' 2>/dev/null
  } | sort -u | while read -r name; do
    [ -z "${open[$name]}" ] && echo "    $name"
  done
}

# ---- commands ------------------------------------------------------------

case "$1" in
  -l)
    while IFS=$'\t' read -r tag name dir port; do
      if is_hot "$tag"; then state=hot; else state=cold; fi
      printf '%s  %-5s %-40s %s%s\n' "$tag" "$state" "$name" "$dir" "${port:+ :$port}"
    done < "$STATE"
    ;;
  -d)
    if [ -n "$2" ]; then
      entry=$(entry_by_name "$2")
      [ -n "$entry" ] || die "no session '$2'"
    else
      tag=$(current_tag) || die "focused window is not a tt window; use: tt -d <name>"
      entry=$(entry_by_tag "$tag")
      [ -n "$entry" ] || die "tag $tag has windows but no session entry"
    fi
    IFS=$'\t' read -r tag name dir port <<<"$entry"
    close_windows "$tag"
    remove_entry "$name"
    ;;
  -n)
    tag=$(current_tag) || die "focused window is not a tt window"
    entry=$(entry_by_tag "$tag")
    [ -n "$entry" ] || die "tag $tag has no session entry"
    IFS=$'\t' read -r tag name dir port <<<"$entry"
    spawn "$tag" "$dir" "$name.${2:-scratch}"
    ;;
  -w)
    [ -n "$2" ] || die "usage: tt -w <branch>"
    branch="$2"
    repo="$MAIN_REPO"
    git -C "$PWD" rev-parse --show-toplevel >/dev/null 2>&1 && repo="$PWD"
    # existing branch first; --create only when it does not exist
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
      (cd "$repo" && wt switch "$branch") || die "wt switch $branch failed"
    else
      (cd "$repo" && wt switch --create "$branch") || die "wt switch --create $branch failed"
    fi
    dir=$(cd "$repo" && wt list --format json 2>/dev/null |
      jq -r --arg b "$branch" '.items[] | select(.branch == $b) | .worktree.path // empty')
    [ -d "$dir" ] || die "cannot find worktree for '$branch' in wt list"
    open_session "$(basename "$dir")" "$dir"
    ;;
  -m)
    pick=$(candidates | dmenu -l 12 -p "tt:") || exit 0
    [ -n "$pick" ] || exit 0
    name=$(printf %s "$pick" | sed 's/^\[[ 0-9]\] //; s/^ *//')
    exec "$0" "$name"
    ;;
  restore)
    while IFS=$'\t' read -r tag name dir port; do
      is_hot "$tag" && continue
      [ -d "$dir" ] || { echo "tt: skip $name, $dir is gone" >&2; continue; }
      spawn_session "$tag" "$name" "$dir" "$port"
      sleep 0.5
    done < "$STATE"
    ;;
  -*|"")
    sed -n '2,/^$/s/^# \{0,1\}//p' "$0"
    exit 1
    ;;
  *)
    open_session "$1" "$2"
    ;;
esac
