#!/bin/sh
# Push-to-talk dictation with a local Whisper model (whisper.cpp).
# Records the microphone, transcribes it on the GPU and types the text
# into the focused window. It never presses Enter.
#
# Usage: dictate start|stop
#     start   start recording (does nothing when a recording runs)
#     stop    stop recording, transcribe and type the text
#
# Bound in sxhkdrc (~/.config/sxhkd/sxhkdrc, in termieter):
#     super + v       -> dictate start
#     super + @v      -> dictate stop
# Let go of v before super. If you let go of super first, sxhkd does not
# see the release and the recording keeps running (the red bar stays).
# Press and release super + v again to stop it.
#
# Setup after a reinstall (Arch Linux, X11):
#
# 1. Packages
#        sudo pacman -S --needed whisper-cpp ggml-vulkan alsa-utils \
#          pipewire-alsa xdotool dzen2 sxhkd
#    whisper-cpp   whisper-cli, the speech-to-text program
#    ggml-vulkan   GPU backend for whisper-cli. Without it, whisper-cli
#                  runs on the CPU (slower, but it works).
#    alsa-utils    arecord, records the microphone
#    pipewire-alsa sends arecord to the PipeWire default source
#                  (pactl get-default-source shows it)
#    xdotool       types the text and reads the screen size
#    dzen2         the status bar at the bottom center
#
# 2. Models (not in git, 1.6 GB and 885 KB)
#        mkdir -p ~/.local/share/whisper && cd ~/.local/share/whisper
#        curl -LO https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin
#        curl -LO https://huggingface.co/ggml-org/whisper-vad/resolve/main/ggml-silero-v6.2.0.bin
#        sha256sum ggml-*.bin
#    Expected SHA-256:
#        1fc70f774d38eb169993ac391eea357ef47c88757ef72ee5943879b7e8e2bc69  ggml-large-v3-turbo.bin
#        2aa269b785eeb53a82983a20501ddf7c1d9c48e33ab63a41391ac6c9f7fb6987  ggml-silero-v6.2.0.bin
#    large-v3-turbo does Dutch and English well. The VAD (voice activity
#    detection) model removes silence. Without it, whisper invents text
#    such as "you" for a silent recording.
#
# 3. Reload sxhkd: pkill -USR1 -x sxhkd (or super + shift + r)
#
# 4. Check the GPU
#        arecord -q -f S16_LE -r 16000 -c 1 -d 5 /tmp/test.wav
#        whisper-cli -m ~/.local/share/whisper/ggml-large-v3-turbo.bin \
#          -f /tmp/test.wav -l auto
#    The log must show "using Vulkan0 backend", and Vulkan device 0 must
#    be the real GPU (Radeon RX 6600 in 2026), not the graphics in the
#    CPU. If device 0 is the wrong GPU, add "-dev 1" to whisper-cli below.
#    A 5 s recording takes about 1.3 s to transcribe on the RX 6600.
#
# Language: "-l auto" detects the language per recording (about 0.4 s
# extra). Use "-l nl" or "-l en" to force one language.

model_dir="$HOME/.local/share/whisper"
model="$model_dir/ggml-large-v3-turbo.bin"
vad_model="$model_dir/ggml-silero-v6.2.0.bin"

run_dir="${XDG_RUNTIME_DIR:-/tmp}"
pid_file="$run_dir/dictate.pid"
osd_pid_file="$run_dir/dictate-osd.pid"
wav_file="$run_dir/dictate.wav"

# Status bar at the bottom center of the screen
osd_font="JetBrainsMono Nerd Font Mono:size=16:style=Bold"
osd_width=480
osd_height=56
osd_bottom=200 # distance from the bottom of the screen

recording() {
  [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null
}

# Usage: osd <background color> <text>
osd() {
  osd_close
  geometry=$(xdotool getdisplaygeometry)
  screen_width=${geometry% *}
  screen_height=${geometry#* }
  x=$(( (screen_width - osd_width) / 2 ))
  y=$(( screen_height - osd_bottom - osd_height ))
  printf '%s\n' "$2" | dzen2 -p -x "$x" -y "$y" -w "$osd_width" \
    -h "$osd_height" -ta c -bg "$1" -fg '#ffffff' -fn "$osd_font" \
    >/dev/null 2>&1 &
  echo $! > "$osd_pid_file"
}

osd_close() {
  [ -f "$osd_pid_file" ] && kill "$(cat "$osd_pid_file")" 2>/dev/null
  rm -f "$osd_pid_file"
}

start() {
  recording && exit 0
  arecord -q -f S16_LE -r 16000 -c 1 "$wav_file" </dev/null >/dev/null 2>&1 &
  echo $! > "$pid_file"
  osd '#dc2626' '● Recording'
}

stop() {
  recording || exit 0
  pid=$(cat "$pid_file")
  kill -INT "$pid"
  # arecord writes the WAV header on exit, so wait for it
  while kill -0 "$pid" 2>/dev/null; do sleep 0.05; done
  rm -f "$pid_file"

  # Move the audio away, so a new recording cannot overwrite it
  audio="$run_dir/dictate-$pid.wav"
  mv "$wav_file" "$audio"

  osd '#7C3AED' 'Transcribing...'
  text=$(whisper-cli -m "$model" -f "$audio" -l auto -nt -np \
    --vad -vm "$vad_model" 2>/dev/null |
    tr '\n' ' ' | tr -s ' ' | sed 's/^ //; s/ $//')
  rm -f "$audio"
  osd_close

  if [ -n "$text" ]; then
    xdotool type --clearmodifiers -- "$text"
  fi
}

case "$1" in
  start) start ;;
  stop) stop ;;
  *) echo "Usage: dictate start|stop" >&2; exit 1 ;;
esac
